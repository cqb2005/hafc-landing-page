      "id": "32934fad-1369-4a52-b2f1-cc0ab2b0211c",
      "name": "Session Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [-780, 540]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst webhookBody = ($('Webhook').first().json.body) || {};\n\nlet output;\ntry {\n  const raw = item.output !== undefined ? item.output : (item.text !== undefined ? item.text : item);\n  const text = typeof raw === 'string' ? raw : JSON.stringify(raw);\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  output = JSON.parse(match ? match[0] : text);\n} catch (e) {\n  output = {\n    reply: \"Sorry, I'm having trouble right now — please call us directly on [PHONE PLACEHOLDER].\",\n    escalate: false,\n    escalation_reason: 'AI response could not be parsed: ' + e.message\n  };\n}\n\nreturn [{\n  json: {\n    session_id: webhookBody.session_id || '',\n    name: webhookBody.name || '',\n    contact: webhookBody.contact || '',\n    message: webhookBody.message || '',\n    reply: output.reply || '',\n    escalate: output.escalate === true,\n    escalation_reason: output.escalate === true ? (output.escalation_reason || '') : null,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
